# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration
# ==============================================================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Persistence Configuration (PostgreSQL / pgvector)
# For local Docker setup:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/lenny_assistant
# For local zero-setup dev/test (SQLite fallback):
# DATABASE_URL=sqlite+aiosqlite:///./lenny_assistant.db

# Default LLM Provider: 'ollama' | 'anthropic' | 'mock'
DEFAULT_LLM_PROVIDER=ollama

# Local LLM (Ollama) Configuration - MANDATORY FOR DEMO
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT_SECONDS=180.0

# Cloud LLM (Anthropic Claude) Configuration
# Supply your Anthropic key if testing Cloud provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
